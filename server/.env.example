# 服务端口（部署平台会注入 PORT，本地默认 8000）
PORT=8000

# Supabase / Neon Postgres 连接串（Dashboard → Connect → Session pooler）
# 形如：postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# 启动时自动建表（首次部署保持 true，稳定后可改 false）
AUTO_MIGRATE=true

# 登录 token 签名密钥，随便一串 32 位以上随机字符
JWT_SECRET=
JWT_DAYS=30

# 管理员账号：首次启动自动创建 / 升级为管理员
ADMIN_EMAIL=2931742378@qq.com
ADMIN_PASSWORD=

# 邮件（QQ 邮箱 SMTP，密码是邮箱授权码，只能在服务端）
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USER=2931742378@qq.com
EMAIL_PASSWORD=
EMAIL_DEFAULT_SENDER=2931742378@qq.com

# 使用事件保留天数（超期由定时任务清理）
EVENT_RETENTION_DAYS=180
